    .hero-subtitle { font-size: 1.3rem; margin-bottom: 40px; opacity: 0.9; animation: fadeInUp 1s ease-out 0.2s both; }
    .url-input-container { background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 20px; padding: 40px; margin: 40px auto; max-width: 600px; box-shadow: 0 20px 40px rgba(0,0,0,0.1); animation: fadeInUp 1s ease-out 0.4s both; }
    .url-input { width: 100%; padding: 18px 25px; font-size: 1.1rem; border: none; border-radius: 50px; margin-bottom: 20px; background: white; box-shadow: 0 10px 30px rgba(0,0,0,0.1); outline: none; transition: all 0.3s ease; }
