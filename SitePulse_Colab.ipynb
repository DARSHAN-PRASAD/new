      </div>
    </div>
    <div class="loading-spinner" id="loadingSpinner"><div class="spinner"></div></div>
    <div id="resultsContent" class="hidden">
      <div class="scores-grid">
        <div class="score-card security-card"><div class="score-number" id="securityScore">--</div><div class="score-label">Security Score</div></div>
        <div class="score-card performance-card"><div class="score-number" id="performanceScore">--</div><div class="score-label">Performance Score</div></div>
        <div class="score-card seo-card"><div class="score-number" id="seoScore">--</div><div class="score-label">SEO Score</div></div>
        <div class="score-card accessibility-card"><div class="score-number" id="accessibilityScore">--</div><div class="score-label">Accessibility Score</div></div>
