</div>

<script>
(function() {
  let auditData = {};
  let currentChart = null;

  const $ = (id) => document.getElementById(id);

  function validateAndNormalizeUrl(raw) {
    if (!raw) return null;
    let val = raw.trim();
    if (!/^https?:\/\//i.test(val)) val = 'https://' + val;
    try { new URL(val); return val; } catch { return null; }
  }

  async function startAudit() {
    const input = $('websiteUrl');
    const normalized = validateAndNormalizeUrl(input.value);
    if (!normalized) { alert('Please enter a valid URL'); return; }
    input.value = normalized;

    // Switch to dashboard
    $('landingPage').style.display = 'none';
    $('dashboard').style.display = 'block';
    $('auditedUrl').textContent = 'Analyzing: ' + normalized;

    // Start progress animation while backend runs
    simulateProgress(async () => {
      try {
        const result = await google.colab.kernel.invokeFunction('sitepulse_run_audit', [normalized], {});
        const data = (result && result.data && (result.data['application/json'] || result.data['text/plain'])) || null;
        auditData = (typeof data === 'string') ? JSON.parse(data) : data;
        showResults();
      } catch (e) {
        console.error(e);
        alert('Audit failed. Please check the URL and try again.');
        goBack();
      }
    });
  }

  function simulateProgress(task) {
    const progressFill = $('progressFill');
    const progressText = $('progressText');
    const loadingSpinner = $('loadingSpinner');
    const resultsContent = $('resultsContent');

    loadingSpinner.style.display = 'flex';
    resultsContent.classList.add('hidden');

    const stages = [
      'Checking SSL certificate...',
      'Analyzing security headers...',
      'Measuring page load time...',
      'Checking Core Web Vitals...',
      'Analyzing SEO meta tags...',
      'Checking accessibility compliance...',
      'Generating recommendations...',
      'Finalizing report...'
    ];

    let currentStage = 0;
    const interval = setInterval(() => {
      if (currentStage < stages.length) {
        progressText.textContent = stages[currentStage];
        progressFill.style.width = ((currentStage + 1) / stages.length) * 100 + '%';
        currentStage++;
      }
    }, 700);

    Promise.resolve(task()).then(() => {
      clearInterval(interval);
      progressText.textContent = 'Audit complete!';
      progressFill.style.width = '100%';
      setTimeout(() => {
        loadingSpinner.style.display = 'none';
      }, 500);
    }).catch(() => clearInterval(interval));
  }

  function showResults() {
    // Update score displays
    $('securityScore').textContent = auditData.security.score;
    $('performanceScore').textContent = auditData.performance.score;
    $('seoScore').textContent = auditData.seo.score;
    $('accessibilityScore').textContent = auditData.accessibility.score;

    createScoresChart();
    generateIssuesList();
    $('resultsContent').classList.remove('hidden');
  }

  function createScoresChart() {
    const ctx = $('scoresChart').getContext('2d');
    if (currentChart) currentChart.destroy();
    currentChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: ['Security', 'Performance', 'SEO', 'Accessibility'],
        datasets: [{
          data: [
            auditData.security.score,
            auditData.performance.score,
            auditData.seo.score,
            auditData.accessibility.score
          ],
          backgroundColor: ['#ff6b6b', '#4CAF50', '#2196F3', '#FF9800'],
          borderWidth: 0,
          cutout: '60%'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom', labels: { padding: 20, usePointStyle: true, font: { size: 14, weight: 'bold' } } }, tooltip: { callbacks: { label: (ctx) => `${ctx.label}: ${ctx.parsed}/100` } } },
        animation: { animateRotate: true, duration: 1500 }
      }
    });
  }

  function generateIssuesList() {
    const issuesList = $('issuesList');
    issuesList.innerHTML = '';

    const allIssues = [
      ...auditData.security.issues.map(i => ({...i, category: 'Security'})),
      ...auditData.performance.issues.map(i => ({...i, category: 'Performance'})),
      ...auditData.seo.issues.map(i => ({...i, category: 'SEO'})),
      ...auditData.accessibility.issues.map(i => ({...i, category: 'Accessibility'})),
    ];

    const severityOrder = { critical: 0, moderate: 1, low: 2 };
    allIssues.sort((a, b) => severityOrder[a.severity] - severityOrder[b.severity]);

    allIssues.forEach((issue, index) => {
      const item = document.createElement('div');
      item.className = `issue-item issue-${issue.severity}`;

      const header = document.createElement('div');
      header.className = 'issue-header';
      const h4 = document.createElement('h4');
      h4.textContent = issue.title;
      const sev = document.createElement('span');
      sev.className = `severity-badge severity-${issue.severity}`;
      sev.textContent = issue.severity.toUpperCase();
      header.appendChild(h4);
      header.appendChild(sev);

      const cat = document.createElement('p');
      cat.innerHTML = `<strong>Category:</strong> ${issue.category}`;

      const details = document.createElement('div');
      details.className = 'issue-details';
      details.id = `details-${index}`;
      const p1 = document.createElement('p'); p1.innerHTML = `<strong>Description:</strong> ${issue.description}`;
      const p2 = document.createElement('p'); p2.innerHTML = `<strong>Impact:</strong> ${issue.impact}`;

      const fix = document.createElement('div'); fix.className = 'fix-suggestion';
      const fixTitle = document.createElement('strong'); fixTitle.textContent = 'Recommended Fix: ';
      const fixText = document.createElement('span'); fixText.textContent = issue.fix;
      const code = document.createElement('div'); code.className = 'code-snippet'; code.textContent = issue.code || '';
      fix.appendChild(fixTitle); fix.appendChild(fixText); fix.appendChild(code);

      details.appendChild(p1); details.appendChild(p2); details.appendChild(fix);

      item.appendChild(header); item.appendChild(cat); item.appendChild(details);

      item.addEventListener('click', () => {
        const isOpen = details.style.display === 'block';
        details.style.display = isOpen ? 'none' : 'block';
      });

      issuesList.appendChild(item);
    });
  }

  async function exportReport(format) {
    if (format === 'pdf') {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ unit: 'pt', format: 'a4' });
      const pageWidth = doc.internal.pageSize.getWidth();
      const margin = 32;

      doc.setFont('helvetica', 'bold');
      doc.setFontSize(18);
      doc.text('SitePulse Audit Report', margin, 40);

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(12);
      doc.text($('auditedUrl').textContent, margin, 60);

      // Render chart + scores section to image
      const target = document.querySelector('.scores-grid');
      const canvas = await html2canvas(target, { scale: 2, backgroundColor: '#ffffff' });
      const imgData = canvas.toDataURL('image/png');
      const imgWidth = pageWidth - margin*2;
      const imgHeight = (canvas.height * imgWidth) / canvas.width;
      doc.addImage(imgData, 'PNG', margin, 80, imgWidth, imgHeight);

      // Issues summary (first 12)
      let y = 100 + imgHeight;
      const allIssues = [
        ...auditData.security.issues.map(i => ({...i, category: 'Security'})),
        ...auditData.performance.issues.map(i => ({...i, category: 'Performance'})),
        ...auditData.seo.issues.map(i => ({...i, category: 'SEO'})),
        ...auditData.accessibility.issues.map(i => ({...i, category: 'Accessibility'})),
      ];
      const maxPerPage = 12;
      for (let i = 0; i < allIssues.length; i++) {
        if (i && i % maxPerPage === 0) { doc.addPage(); y = 40; }
        const it = allIssues[i];
        const line = `${it.category} | ${it.severity.toUpperCase()} | ${it.title}`;
        doc.text(line, margin, y);
        y += 18;
      }

      doc.save('sitepulse-audit-report.pdf');
    } else if (format === 'csv') {
      let csvContent = 'Category,Issue,Severity,Description,Impact,Fix\n';
      const allIssues = [
        ...auditData.security.issues.map(i => ({...i, category: 'Security'})),
        ...auditData.performance.issues.map(i => ({...i, category: 'Performance'})),
        ...auditData.seo.issues.map(i => ({...i, category: 'SEO'})),
        ...auditData.accessibility.issues.map(i => ({...i, category: 'Accessibility'})),
      ];
      const esc = (s) => '"' + String(s).replace(/\"/g, '""') + '"';
      allIssues.forEach(issue => {
        csvContent += [esc(issue.category), esc(issue.title), esc(issue.severity), esc(issue.description), esc(issue.impact), esc(issue.fix)].join(',') + '\n';
      });
      const blob = new Blob([csvContent], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = 'sitepulse-audit-report.csv'; a.click();
      window.URL.revokeObjectURL(url);
    }
  }

  function goBack() {
    $('dashboard').style.display = 'none';
    $('landingPage').style.display = 'block';
    $('websiteUrl').value = '';
    $('progressFill').style.width = '0%';
    $('progressText').textContent = 'Initializing scan...';
    $('resultsContent').classList.add('hidden');
  }

  // Wire events
  $('auditBtn').addEventListener('click', startAudit);
  $('websiteUrl').addEventListener('keypress', function(e){ if (e.key === 'Enter') startAudit(); });
  $('backBtn').addEventListener('click', goBack);
  $('exportPdfBtn').addEventListener('click', () => exportReport('pdf'));
  $('exportCsvBtn').addEventListener('click', () => exportReport('csv'));
})();
</script>import asyncio
import json
import re
import time
from dataclasses import dataclass, asdict
from typing import Dict, List, Any

import aiohttp
import requests
from bs4 import BeautifulSoup
import tldextract
import validators
from tqdm import tqdm

USER_AGENT = "SitePulse/1.0 (+https://colab.research.google.com)"

@dataclass
class Issue:
    title: str
    severity: str
    description: str
    impact: str
    fix: str
    code: str

@dataclass
class CategoryResult:
    score: int
    issues: List[Issue]

@dataclass
class AuditResult:
    security: CategoryResult
    performance: CategoryResult
    seo: CategoryResult
    accessibility: CategoryResult


def clamp_score(value: int) -> int:
    return max(0, min(100, int(value)))


def extract_domain(url: str) -> str:
    ext = tldextract.extract(url)
    domain = f"{ext.domain}.{ext.suffix}" if ext.suffix else ext.domain
    return domain


async def fetch_head(session: aiohttp.ClientSession, url: str) -> aiohttp.ClientResponse:
    try:
        return await session.head(url, allow_redirects=True)
    except Exception:
        return await session.get(url, allow_redirects=True)


async def check_security(url: str, session: aiohttp.ClientSession) -> CategoryResult:
    issues: List[Issue] = []

    # SSL check (basic): https vs http
    if not url.lower().startswith("https://"):
        issues.append(Issue(
            title="Site not using HTTPS",
            severity="critical",
            description="Primary URL is not using HTTPS.",
            impact="Insecure transport. Susceptible to interception and tampering.",
            fix="Use HTTPS with a valid TLS certificate and redirect HTTP to HTTPS.",
            code="server {\n  listen 443 ssl;\n  return 301 https://$host$request_uri;\n}"
        ))
        https_bonus = 0
    else:
        https_bonus = 20

    # Security headers check
    try:
        async with session.get(url) as resp:
            hdrs = {k.lower(): v for k, v in resp.headers.items()}
            missing = []
            required = [
                ("content-security-policy", "Mitigates XSS and data injection."),
                ("x-frame-options", "Prevents clickjacking."),
                ("x-content-type-options", "Prevents MIME sniffing."),
                ("referrer-policy", "Controls referrer leakage."),
                ("strict-transport-security", "Enforces HTTPS on subsequent requests."),
            ]
            for name, reason in required:
                if name not in hdrs:
                    missing.append((name, reason))

            if missing:
                description = ", ".join([n for n, _ in missing])
                issues.append(Issue(
                    title="Missing security headers",
                    severity="moderate",
                    description=f"Missing headers: {description}",
                    impact="Reduced protection against common web threats.",
                    fix="Add recommended headers to your server config.",
                    code=(
                        "# Example (Nginx)\n"
                        "add_header X-Frame-Options 'SAMEORIGIN' always;\n"
                        "add_header X-Content-Type-Options 'nosniff' always;\n"
                        "add_header Referrer-Policy 'strict-origin-when-cross-origin' always;\n"
                        "add_header Strict-Transport-Security 'max-age=31536000; includeSubDomains' always;\n"
                        "add_header Content-Security-Policy "
                        "\"default-src 'self' 'unsafe-inline' 'unsafe-eval' data: https:;\" always;"
                    )
                ))
    except Exception:
        pass

    # Simple SSL expiry hint: cannot robustly check without openssl/cert parse cross-origin
    # Provide a moderate severity reminder
    issues.append(Issue(
        title="Review TLS certificate expiry",
        severity="low",
        description="Ensure certificate has >30 days before expiry.",
        impact="Expired cert breaks trust and blocks users.",
        fix="Automate renewal with Let's Encrypt and monitoring.",
        code="# cron example\n0 0 * * * certbot renew --quiet"
    ))

    # Score heuristic
    base = 60 + https_bonus
    penalty = 0
    for i in issues:
        if i.severity == "critical":
            penalty += 25
        elif i.severity == "moderate":
            penalty += 12
        else:
            penalty += 4
    score = clamp_score(base - penalty)
    return CategoryResult(score=score, issues=issues)


def measure_performance_sync(url: str) -> CategoryResult:
    issues: List[Issue] = []
    start = time.time()
    try:
        resp = requests.get(url, headers={"User-Agent": USER_AGENT}, timeout=20)
        elapsed_ms = int((time.time() - start) * 1000)
        content_length = int(resp.headers.get("content-length", "0") or 0)
        if elapsed_ms > 3000:
            issues.append(Issue(
                title="Slow initial load time",
                severity="moderate",
                description=f"First-byte+transfer took ~{elapsed_ms}ms.",
                impact="Users perceive slowness; SEO may be impacted.",
                fix="Enable caching, compress assets (gzip/br), use a CDN.",
                code="# nginx gzip\ngzip on; gzip_types text/css application/javascript;"
            ))
        if content_length > 1_000_000:
            issues.append(Issue(
                title="Large page payload",
                severity="moderate",
                description=f"Response size ~{content_length/1024:.0f}KB.",
                impact="Longer load and higher data costs.",
                fix="Minify resources and lazy-load non-critical content.",
                code="<!-- Lazy load images -->\n<img src=\"hero.webp\" loading=\"lazy\" alt=\"...\">"
            ))

        # Basic unused CSS/JS heuristic via inline size
        soup = BeautifulSoup(resp.text, "html.parser")
        scripts = soup.find_all("script")
        links = soup.find_all("link", rel=re.compile("stylesheet", re.I))
        if len(scripts) + len(links) > 10:
            issues.append(Issue(
                title="Many CSS/JS resources",
                severity="low",
                description=f"Detected {len(links)} stylesheets and {len(scripts)} scripts.",
                impact="Potential render-blocking resources.",
                fix="Bundle and code-split. Use preload/async/defer.",
                code="<script src=\"app.js\" defer></script>"
            ))

        # Score heuristic
        base = 70
        penalty = sum(12 if i.severity == "moderate" else 5 for i in issues)
        score = clamp_score(base - penalty)
        return CategoryResult(score=score, issues=issues)
    except Exception:
        return CategoryResult(score=55, issues=[Issue(
            title="Failed to fetch page",
            severity="critical",
            description="Could not fetch the page for performance checks.",
            impact="Performance signals unavailable.",
            fix="Verify URL accessibility and CORS/network conditions.",
            code="curl -I https://example.com"
        )])


def check_seo_sync(url: str) -> CategoryResult:
    issues: List[Issue] = []
    try:
        resp = requests.get(url, headers={"User-Agent": USER_AGENT}, timeout=20)
        soup = BeautifulSoup(resp.text, "html.parser")

        # Meta description
        meta_desc = soup.find("meta", attrs={"name": re.compile("description", re.I)})
        if not meta_desc or not meta_desc.get("content"):
            issues.append(Issue(
                title="Missing meta description",
                severity="moderate",
                description="No meta description found.",
                impact="May reduce CTR in search results.",
                fix="Add a 120-160 character, unique description.",
                code="<meta name=\"description\" content=\"Compelling summary under 160 chars\">"
            ))

        # Robots.txt and sitemap
        domain = extract_domain(url)
        scheme = "https" if url.startswith("https") else "http"
        robots_url = f"{scheme}://{domain}/robots.txt"
        sitemap_url = f"{scheme}://{domain}/sitemap.xml"
        r1 = requests.get(robots_url, headers={"User-Agent": USER_AGENT}, timeout=10)
        if r1.status_code != 200:
            issues.append(Issue(
                title="robots.txt not found",
                severity="low",
                description=f"No robots.txt at {robots_url}",
                impact="Crawlers may not know your crawl rules.",
                fix="Add robots.txt at site root.",
                code="User-agent: *\nAllow: /\nSitemap: https://example.com/sitemap.xml"
            ))
        r2 = requests.get(sitemap_url, headers={"User-Agent": USER_AGENT}, timeout=10)
        if r2.status_code != 200:
            issues.append(Issue(
                title="XML sitemap not found",
                severity="moderate",
                description=f"No sitemap at {sitemap_url}",
                impact="Search engines may miss pages.",
                fix="Generate and submit an XML sitemap.",
                code="<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n  <url><loc>https://example.com/</loc></url>\n</urlset>"
            ))

        # Title tag length
        title = soup.find("title")
        if not title or not title.text.strip():
            issues.append(Issue(
                title="Missing title tag",
                severity="moderate",
                description="No <title> found.",
                impact="Poor SEO relevance.",
                fix="Add a concise, keyword-rich title (50-60 chars).",
                code="<title>Brand | Primary Keyword</title>"
            ))
        elif len(title.text.strip()) < 20 or len(title.text.strip()) > 65:
            issues.append(Issue(
                title="Title length suboptimal",
                severity="low",
                description=f"Title length is {len(title.text.strip())} chars.",
                impact="May truncate or lack clarity.",
                fix="Keep titles 50-60 chars with primary keyword early.",
                code="<title>Acme Analytics | Website Audit Software</title>"
            ))

        base = 72
        penalty = sum(12 if i.severity == "moderate" else 5 for i in issues)
        score = clamp_score(base - penalty)
        return CategoryResult(score=score, issues=issues)
    except Exception:
        return CategoryResult(score=60, issues=[Issue(
            title="SEO fetch failed",
            severity="critical",
            description="Could not retrieve HTML for SEO checks.",
            impact="SEO insights limited.",
            fix="Check URL and allow fetching.",
            code="curl -s https://example.com | head"
        )])


def check_accessibility_sync(url: str) -> CategoryResult:
    issues: List[Issue] = []
    try:
        resp = requests.get(url, headers={"User-Agent": USER_AGENT}, timeout=20)
        soup = BeautifulSoup(resp.text, "html.parser")

        # Alt text check
        imgs = soup.find_all("img")
        missing_alt = [img for img in imgs if not img.get("alt")]
        if missing_alt:
            issues.append(Issue(
                title="Images missing alt text",
                severity="moderate",
                description=f"{len(missing_alt)} images without alt.",
                impact="Screen readers cannot describe images.",
                fix="Add descriptive alt attributes.",
                code="<img src=\"chart.png\" alt=\"Sales grew 25% YoY\">"
            ))

        # Form labels
        inputs = soup.find_all(["input", "select", "textarea"])
        unlabeled = 0
        for el in inputs:
            if el.get("type") in {"hidden", "submit", "button", "image"}:
                continue
            id_attr = el.get("id")
            has_label = False
            if id_attr:
                has_label = bool(soup.find("label", attrs={"for": id_attr}))
            if not has_label and not el.get("aria-label") and not el.get("aria-labelledby"):
                unlabeled += 1
        if unlabeled:
            issues.append(Issue(
                title="Form fields missing labels",
                severity="moderate",
                description=f"{unlabeled} inputs without labels.",
                impact="Hard to use with assistive tech.",
                fix="Associate labels using for/id or aria-label.",
                code="<label for=\"email\">Email</label><input id=\"email\">"
            ))

        # Contrast heuristics are hard server-side; provide a low-level suggestion
        issues.append(Issue(
            title="Review color contrast",
            severity="low",
            description="Automated contrast checks limited without rendering.",
            impact="Some text may be hard to read.",
            fix="Use WCAG AA contrast ratios and test key pages.",
            code="/* Prefer dark text on light backgrounds */\ncolor: #222; background: #fff;"
        ))

        base = 68
        penalty = sum(12 if i.severity == "moderate" else 4 for i in issues)
        score = clamp_score(base - penalty)
        return CategoryResult(score=score, issues=issues)
    except Exception:
        return CategoryResult(score=58, issues=[Issue(
            title="Accessibility fetch failed",
            severity="critical",
            description="Could not load page for a11y checks.",
            impact="Accessibility insights limited.",
            fix="Check URL accessibility.",
            code="curl -I https://example.com"
        )])


async def run_audit(url: str) -> AuditResult:
    if not validators.url(url):
        raise ValueError("Invalid URL")

    async with aiohttp.ClientSession(headers={"User-Agent": USER_AGENT}) as session:
        security = await check_security(url, session)

    performance = measure_performance_sync(url)
    seo = check_seo_sync(url)
    accessibility = check_accessibility_sync(url)

    return AuditResult(
        security=security,
        performance=performance,
        seo=seo,
        accessibility=accessibility,
    )


# Colab bridge function: called from JS via google.colab.kernel.invokeFunction
from google.colab import output

async def _py_run_audit(url: str) -> Dict[str, Any]:
    result = await run_audit(url)
    # Convert dataclasses to dict
    def ser_issue(issue: Issue) -> Dict[str, Any]:
        return asdict(issue)
    def ser_cat(cat: CategoryResult) -> Dict[str, Any]:
        return {"score": cat.score, "issues": [ser_issue(i) for i in cat.issues]}
    data = {
        "security": ser_cat(result.security),
        "performance": ser_cat(result.performance),
        "seo": ser_cat(result.seo),
        "accessibility": ser_cat(result.accessibility),
    }
    return data


def py_run_audit(url: str):
    return asyncio.get_event_loop().run_until_complete(_py_run_audit(url))

output.register_callback("sitepulse_run_audit", py_run_audit)
